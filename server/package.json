{
  "name": "xdash-server",
  "version": "1.0.0",
  "private": true,
  "description": "xdash serverless server on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create xdash",
    "db:init": "wrangler d1 execute xdash --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute xdash --local --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250615.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.90.0"
  }
}
