# ===== xdash 服务端环境变量 =====
# 复制为 .env 并填入真实值（.env 不会被提交到 git）

# 监听端口
PORT=3000

# 客户端握手 token（必须与 Rust 客户端 XDASH_TOKEN 完全一致）
DEVICE_TOKEN=请改为随机长串

# 网页登录密码
WEB_PASSWORD=请改为强密码

# 会话签名密钥（建议随机长串，可用 `openssl rand -hex 32` 生成）
JWT_SECRET=请改为随机长串

# SQLite 数据库文件路径（默认在 data/ 下）
DB_PATH=./data/xdash.db

# 静态网页资源目录（默认 ../web）
WEB_DIR=../web

# 历史数据保留天数（默认 7）
HISTORY_DAYS=7

# 是否信任反向代理（若用 nginx 等反向代理设为 true，以读取真实公网 IP）
TRUST_PROXY=false
