# xdash 客户端 systemd 服务模板
#
# 安装步骤（在 Linux 服务器上以 root 执行）：
#   1. 把编译好的二进制放到 /usr/local/bin/xdash 并赋予执行权限：
#        install -m 0755 xdash /usr/local/bin/xdash
#   2. 复制本文件到 /etc/systemd/system/xdash.service
#   3. 编辑本文件，填入 XDASH_URL 与 XDASH_TOKEN（见下方 Environment）
#   4. 启动并设为开机自启：
#        systemctl daemon-reload
#        systemctl enable --now xdash
#   5. 查看状态/日志：
#        systemctl status xdash
#        journalctl -u xdash -f

[Unit]
Description=xdash server monitor client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/xdash

# 环境变量（请按实际情况修改）
Environment="XDASH_URL=wss://your-worker.your-subdomain.workers.dev/ws"
Environment="XDASH_TOKEN=替换为与服务端一致的预共享 token"
# Environment="XDASH_INTERVAL=3"

# 运行身份（降低权限）
User=nobody
Group=nogroup

# 重启策略
Restart=always
RestartSec=5

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# 注意：读取系统指标需要保留相应能力；不要加 RestrictAddressFamilies 限制 AF_NETLINK 等

[Install]
WantedBy=multi-user.target
